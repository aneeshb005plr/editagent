# =============================================================================
# EditEdge .env — every value below is labeled with how confident I actually
# am in it. Nothing here is guessed silently.
#
#   [CONFIRMED]  - I've seen this exact value in your real output/logs
#   [DECISION]   - agreed on explicitly during discovery/architecture discussion
#   [SUGGESTED]  - my own untuned default, flagged throughout the build as
#                  needing real tuning once you have real usage/timing data
#   [UNKNOWN]    - a real secret or value I have never seen - you MUST fill
#                  this in yourself, the placeholder will not work as-is
# =============================================================================

ENVIRONMENT=development
DEBUG=true

# -----------------------------------------------------------------------------
# GenAI shared service
# -----------------------------------------------------------------------------
# [CONFIRMED] - seen verbatim in your real test-run logs (the "httpx - HTTP
# Request: POST https://genai-sharedservice-americas.pwcinternal.com/..." lines)
GENAI_BASE_URL=https://genai-sharedservice-americas.pwcinternal.com

# [UNKNOWN] - never shared with me, obviously - your real key
GENAI_API_KEY=

# [UNKNOWN] - I used "azure.gpt-4.1" as a placeholder in test scripts during
# this build, but that was MY invention for illustration, never confirmed by
# you as the real model string your GenAI service expects. Check what your
# real endpoint actually accepts before trusting this value.
GENAI_LLM_MODEL=azure.gpt-4.1

# [SUGGESTED] - never confirmed against real usage; your real production test
# run showed a single judgment-pass LLM call taking ~30s on a tiny document,
# which doesn't by itself tell us what token budget is right - just that
# whatever this is set to should comfortably cover a full batch's response.
GENAI_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
# [UNKNOWN] - your real Atlas (or other) connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# File handling
# -----------------------------------------------------------------------------
# [DECISION] - confirmed explicitly during discovery: 100MB is the real,
# non-negotiable ceiling that drove the whole async job architecture.
MAX_FILE_SIZE_MB=100

# -----------------------------------------------------------------------------
# Job system (app/jobs/) - all four settings below are [SUGGESTED],
# explicitly flagged throughout the build as untuned defaults - none of these
# have been validated against real usage or a real large-file timing run yet.
# -----------------------------------------------------------------------------
MAX_QUEUED_JOBS_PER_USER=5
POLL_INTERVAL_SECONDS=5
STALE_JOB_THRESHOLD_SECONDS=900
MAX_CONCURRENT_JOBS=3

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# [DECISION] - "header" matches the confirmed reality that Entra auth wasn't
# implemented in the first app this pattern is modeled on. Flip to "entra"
# once that's genuinely wired up and tested for a given environment.
AUTH_MODE=header

# [UNKNOWN] - required by your real app/auth/entra.py the moment AUTH_MODE
# is switched to "entra" (used to build both the issuer URL and the JWKS
# discovery URL) - your real Entra tenant ID
ENTRA_TENANT_ID=

# [DECISION-ADJACENT] - your own entra.py already implements this exact gate
# (AUTH_DEV_BYPASS and not IS_PRODUCTION -> skip JWT signature verification).
# true is reasonable for local dev; the two flags below together determine
# whether that bypass is actually reachable - see the real finding from
# testing: this bypass currently also skips the tenant check, not just the
# signature check - worth a decision on your end (see our recent conversation).
AUTH_DEV_BYPASS=true
IS_PRODUCTION=false